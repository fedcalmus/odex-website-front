# Copy to .env (or .env.local to override per machine).

# Base URL of the backend API, no trailing slash needed.
NEXT_PUBLIC_API_BASE_URL=https://api.mozaracing.am

# Canonical site origin for metadataBase / sitemap / structured data.
# Falls back to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
